rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isUnderSize(maxMegabytes) {
      return request.resource.size < maxMegabytes * 1024 * 1024;
    }

    match /rescue-photos/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isUnderSize(10);
    }
    
    match /animal-photos/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isUnderSize(10);
    }
    
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId && isImage() && isUnderSize(5);
    }
    
    match /lostfound-photos/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isUnderSize(10);
    }
  }
}
