# Public Supabase project URL for browser client connections
VITE_SUPABASE_URL=
# Public anonymous API key for browser client authentication and real-time channels
VITE_SUPABASE_ANON_KEY=
# Optional Sentry DSN for frontend crash reporting and performance monitoring
VITE_SENTRY_DSN=
# Contact email displayed across legal and support pages
VITE_CONTACT_EMAIL=support@aniresq.org
# Organization / initiative name displayed across legal and support pages
VITE_ORG_NAME=AniResQ
# Flag indicating whether legal templates have been reviewed and approved by a qualified lawyer ('true' or 'false')
VITE_LEGAL_REVIEWED=false
