# =========================================================================
# AniResQ Backend API Environment Variables (apps/api/.env)
# =========================================================================

# Supabase Project URL (from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (NEVER expose to the frontend; backend only)
# Grants administrative database and auth management rights
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Allowed CORS origins for frontend requests (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Rate Limiting Configuration
# TRUST_PROXY_HEADERS: Set to 'true' ONLY when deployed behind a trusted reverse proxy
# (e.g. Nginx, Cloudflare, Traefik, AWS ALB, Render) that overwrites X-Forwarded-For.
# If 'false' (default), the rate limiter strictly uses the TCP socket client IP to prevent spoofing.
TRUST_PROXY_HEADERS=false

# Baseline sliding-window rate limit for general read queries per minute (default: 120)
# Sensitive intake/surrender endpoints have stricter sub-limits:
# - POST /api/animals/surrender: 10 req/min
# - POST /api/rescues, POST /api/lostfound: 15 req/min
# - Other mutations (POST/PATCH/DELETE): 40 req/min
RATE_LIMIT_PER_MINUTE=120

# Optional: Default credentials for apps/api/seed_users.py
SEED_ADMIN_EMAIL=admin@aniresq.com
SEED_ADMIN_PASSWORD=your_secure_admin_password
SEED_CITIZEN_EMAIL=citizen@aniresq.com
SEED_CITIZEN_PASSWORD=your_secure_citizen_password
