# =========================================================================
# AniResQ Backend API Environment Variables (apps/api/.env)
# =========================================================================

# Environment Mode: 'development', 'test', or 'production'
# In production, CORS_ORIGINS must be explicitly configured (no wildcards allowed)
ENV=development

# Supabase Project URL (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (NEVER expose to the frontend; backend only)
# Grants administrative database and auth management rights
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Supabase JWT Secret (for local token signature verification without Auth API network calls)
# Found in Supabase Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# User role and profile in-memory cache TTL in seconds (default: 60)
AUTH_CACHE_TTL_SECONDS=60

# Redis Connection URL for shared multi-worker rate limiting
# Example: redis://localhost:6379/0 or rediss://default:password@host:port
REDIS_URL=

# Allowed CORS origins for frontend requests (comma-separated, no wildcards allowed in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Rate Limiting & Proxy Configuration
# TRUST_PROXY_HEADERS: Set to 'true' ONLY when deployed behind a trusted reverse proxy
# (e.g. Nginx, Cloudflare, Traefik, AWS ALB) that appends client IP to X-Forwarded-For.
# When 'false' (default), rate limiter strictly uses TCP socket client IP to prevent spoofing.
TRUST_PROXY_HEADERS=false

# TRUSTED_PROXIES_COUNT: Number of trusted reverse proxy hops (default: 1).
# Extracts the client IP from the trusted hop (X-Forwarded-For[-TRUSTED_PROXIES_COUNT]),
# ensuring spoofed client-supplied values at the beginning of the header are never trusted.
TRUSTED_PROXIES_COUNT=1

# Rate Limit Thresholds (requests per 60-second window)
RATE_LIMIT_READ=120
RATE_LIMIT_MUTATION=40
RATE_LIMIT_SURRENDER=10
RATE_LIMIT_INTAKE_POST=15
RATE_LIMIT_CLEARANCE_REQUEST=10

# Maximum incoming request payload size in bytes (default: 10485760 = 10MB)
MAX_REQUEST_BODY_BYTES=10485760

# Optional: Default credentials for apps/api/seed_users.py (development only)
SEED_ADMIN_EMAIL=admin@aniresq.com
SEED_ADMIN_PASSWORD=your_secure_admin_password
SEED_CITIZEN_EMAIL=citizen@aniresq.com
SEED_CITIZEN_PASSWORD=your_distinct_citizen_password
