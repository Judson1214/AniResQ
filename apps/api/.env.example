# Environment deployment mode ('development', 'test', or 'production')
ENV=
# Project URL from Supabase dashboard settings
SUPABASE_URL=
# Service role secret key granting backend administrative database rights
SUPABASE_SERVICE_ROLE_KEY=
# Secret key for local JWT verification and signature validation
SUPABASE_JWT_SECRET=
# Comma-separated list of allowed CORS origin domains for browser requests
CORS_ORIGINS=
# Flag indicating whether reverse proxy X-Forwarded-For headers should be trusted ('true' or 'false')
TRUST_PROXY_HEADERS=
# Number of reverse proxy hops to trust when resolving client IP addresses
TRUSTED_PROXIES_COUNT=
# Redis connection URL for shared multi-worker rate limiting
REDIS_URL=
# Explicit override flag permitting in-memory rate limiting in production mode
ALLOW_IN_MEMORY_RATE_LIMIT=
# Maximum allowable request body payload size in bytes
MAX_REQUEST_BODY_BYTES=
# User role and authorization clearance cache expiration in seconds
AUTH_CACHE_TTL_SECONDS=
# Maximum allowed read requests per 60-second window
RATE_LIMIT_READ=
# Maximum allowed mutation requests per 60-second window
RATE_LIMIT_MUTATION=
# Maximum allowed animal surrender requests per 60-second window
RATE_LIMIT_SURRENDER=
# Maximum allowed lost/found intake posts per 60-second window
RATE_LIMIT_INTAKE_POST=
# Maximum allowed volunteer role clearance requests per 60-second window
RATE_LIMIT_CLEARANCE_REQUEST=
# Maximum allowed account data export requests per 3600-second window
RATE_LIMIT_USER_EXPORT=
# Maximum allowed account deletion requests per 3600-second window
RATE_LIMIT_USER_DELETE=
# Maximum allowed content report creation requests per 3600-second window
RATE_LIMIT_REPORT_POST=
# Default admin user email for local development seeding
SEED_ADMIN_EMAIL=
# Default admin user password for local development seeding
SEED_ADMIN_PASSWORD=
# Default citizen user email for local development seeding
SEED_CITIZEN_EMAIL=
# Default citizen user password for local development seeding
SEED_CITIZEN_PASSWORD=
# Flag indicating whether backend is running in unit/integration test mode
TESTING=
# Optional Sentry DSN endpoint for error reporting and application telemetry
SENTRY_DSN=
# Optional sampling rate for performance traces in Sentry (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=
# Secret Bearer token required to access the /metrics operational endpoint
METRICS_TOKEN=
